# NIYAM AI — Environment Configuration Template
# All production deployments MUST set cryptographically random secrets.

PORT=8080
NODE_ENV=development

# 64+ Character Cryptographic Secret for HMAC-SHA256 Token Signing
JWT_SECRET=replace-with-a-64-character-cryptographically-secure-random-secret-for-production

# Comma-separated list of permitted origins for Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=https://niyam-ai-2-nu.vercel.app,http://localhost:8080,http://localhost:3000
