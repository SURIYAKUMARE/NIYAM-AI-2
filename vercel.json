{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__route__=$1"
    },
    {
      "source": "/((?!api/|styles/|js/|images/|seed/|data/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
